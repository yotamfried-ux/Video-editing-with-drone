# Copy to `.studio-cloud.env` (git-ignored) and fill in. Then:  npm run start:cloud
# Everything stays on this computer; the browser never receives these values.

# Where Annotation Studio keeps its database, labels and caches (a normal folder on YOUR disk).
STUDIO_HOME=C:\Users\you\sportreel-studio

# --- Read-only access to SportReel's existing videos in Cloudflare R2 -------------------------------------------
# Create an R2 API token with permission "Object Read only", scoped to the bucket (Cloudflare dashboard -> R2 ->
# Manage API tokens). It cannot write or delete, so nothing the Studio does can change your originals.
STUDIO_CLOUD_R2_ACCOUNT_ID=
STUDIO_CLOUD_R2_BUCKET=sportreel
STUDIO_CLOUD_R2_ACCESS_KEY_ID=
STUDIO_CLOUD_R2_SECRET_ACCESS_KEY=

# --- Optional: the durable upload records (sha256, upload date, batch) ----------------------------------------
# An export of Supabase table public.source_uploads (JSON or CSV). Without it the Studio still works: it hashes a
# video from its bytes the first time you open it.
# STUDIO_CLOUD_METADATA=C:\Users\you\sportreel-studio\source_uploads.csv

# --- Optional: show only some videos in the catalog (e.g. drone footage) ---------------------------------------
# STUDIO_CLOUD_INCLUDE=DJI

# --- Optional: a permanent address (https://studio.yourdomain.com) through a Cloudflare Tunnel -------------------
# All three are required; without the two Access values the permanent address is refused (fail closed).
# Step by step: docs/annotation-studio/PERMANENT-ADDRESS.md
# STUDIO_PUBLIC_HOST=studio.yourdomain.com
# STUDIO_ACCESS_TEAM=yourteam
# STUDIO_ACCESS_AUD=
