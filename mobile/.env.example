# SportReel — mobile (Expo) local configuration.
#
#   cp mobile/.env.example mobile/.env
#
# mobile/.env is gitignored and is ONLY read when you run the app locally
# (`npx expo start`). EAS builds take these from the `env` block of the
# matching profile in mobile/eas.json — keep the two in sync.
#
# Every value below is a public client value: the Supabase publishable key
# and the Stripe publishable key are meant to ship in the bundle, and access
# is enforced by RLS plus the web-api boundary. Never put the Supabase
# service-role key, OPERATOR_SECRET, or any other secret in this file — it is
# bundled into the app and readable by anyone who installs it.
#
# All of these have committed defaults in src/shared/lib/publicEnv.ts, so a
# fresh clone runs without this file. Set a value here to override the
# default (e.g. to point at a staging project); leave it blank/absent to keep
# the default. An empty value is treated as "not set".

# Supabase project — REST, auth, and storage.
EXPO_PUBLIC_SUPABASE_URL=https://bcndgmymnismbxvdeetc.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_mwAM5lvgulv3sCtrHm-OkA_4wMCpNZJ

# web-api boundary (Next.js on Vercel) — operator actions, checkout, media.
EXPO_PUBLIC_API_BASE_URL=https://video-editing-with-drone.vercel.app

# Public domain used to build shareable reel links.
EXPO_PUBLIC_APP_DOMAIN=sportreel.app

# Stripe publishable key (test key by default — safe to commit).
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51TgXCICwQyJBd9MdnZum7LfttimmjbMwlys25dS7GGXDj4B9aX5uWla3sN84KkpaKpX3txVPIr0y65UygDVH6OUG007rD31Tyq

# Set to any non-empty value to show the Bit payment option at checkout.
EXPO_PUBLIC_BIT_ENABLED=
