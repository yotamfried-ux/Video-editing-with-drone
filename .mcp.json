{
  "mcpServers": {
    "graphify": {
      "command": "bash",
      "args": ["${PWD}/.claude/hooks/graphify-mcp.sh"],
      "env": {}
    },
    "maestro": {
      "command": "maestro",
      "args": ["mcp"],
      "env": {}
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"],
      "env": {}
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"],
      "env": {}
    }
  }
}
